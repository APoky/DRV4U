to compile user space dma-test:
# Define the variable
SYSROOT_PATH="/home/htr/poky-projects/Sources/tmp/work/qemuarm64-poky-linux/linux-yocto/5.15.179+gitAUTOINC+896128cbf5_2bf9cba52f-r0/recipe-sysroot"

# Run the cross-compiler, explicitly telling it where the target headers are
aarch64-poky-linux-gcc d-test.c -g -o dma-test --sysroot=$SYSROOT_PATH

root@qemuarm64:~/test# ./dma-test 
--- DMA Driver Character Device Test ---
